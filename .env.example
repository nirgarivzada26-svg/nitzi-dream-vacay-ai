# Copy to `.env` and fill in for your environment. Never commit real secrets.

# --- Supabase (existing) ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only, service-role key. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Live provider switch (existing) ---
# Master switch: adapters only report "configured" when this is "true" AND
# their own required env vars below are set. Leave unset/false for demo mode.
NITZI_LIVE_MODE=false

# --- Payments (newly wired into the booking flow) ---
# Required to accept real charges. Without these, placeBooking creates
# bookings with payment_status = "demo" and no charge is attempted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (newly wired: booking confirmation) ---
# Required to actually send the booking confirmation email. Without these,
# the booking still succeeds but no email is sent (logged to notification_log
# and app_error_log instead).
LOVABLE_API_KEY=
NITZI_EMAIL_FROM=

# --- Admin bootstrap (newly gated) ---
# Set to "true" ONLY while claiming the first super_admin on a fresh
# deployment, then unset it (or set to "false"). Once any staff row exists,
# the database-side claim_super_admin RPC refuses further claims regardless
# of this flag, so it only matters for that first-run window.
ADMIN_BOOTSTRAP_ENABLED=false
